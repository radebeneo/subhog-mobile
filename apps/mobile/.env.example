# Required: Public Clerk publishable key for authentication
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Optional: Set to 'development' during local dev (__DEV__) to enable in-memory subscription data.
# When omitted or in release builds, the app displays "Backend not connected".
EXPO_PUBLIC_DATA_MODE=development

# Optional PostHog analytics (suppressed automatically when EXPO_PUBLIC_DATA_MODE=development)
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
